<Window x:Class="DofusTabs.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuracion"
    Height="400"
        Width="520"
    MinHeight="400"
        MinWidth="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/Icon.png"
        Background="#131515"
        Foreground="#E5E8E8">
    <Window.Resources>
        <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="#2A2F2F"/>
            <Setter Property="Foreground" Value="#E5E8E8"/>
            <Setter Property="BorderBrush" Value="#3E4545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#384040"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#222626"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HotkeyCaptureButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#2A2F2F"/>
            <Setter Property="Foreground" Value="#E5E8E8"/>
            <Setter Property="BorderBrush" Value="#3E4545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#384040"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Panel de configuracion"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1"
                Background="#1B1E1E"
                BorderBrush="#353B3B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Atajos de teclado globales" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Siguiente cuenta" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="NextHotkeyButton"
                            Grid.Column="1"
                            Style="{StaticResource HotkeyCaptureButtonStyle}"
                            Click="NextHotkeyButton_Click"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Cuenta anterior" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="PrevHotkeyButton"
                            Grid.Column="1"
                            Style="{StaticResource HotkeyCaptureButtonStyle}"
                            Click="PrevHotkeyButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#151717"
                BorderBrush="#2A3030"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Para habilitar o deshabilitar una cuenta, haz click derecho sobre su burbuja en la sidebar."
                           TextWrapping="Wrap"
                           Foreground="#B9C1C1"
                           FontSize="12"/>
                <CheckBox x:Name="ShowSidebarNamesCheckBox"
                          Margin="0,10,0,0"
                          Foreground="#E5E8E8"
                          FontSize="12"
                          Checked="ShowSidebarNamesCheckBox_Changed"
                          Unchecked="ShowSidebarNamesCheckBox_Changed"
                          Content="Mostrar nombre debajo de cada burbuja"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton"
                    Style="{StaticResource SettingsActionButtonStyle}"
                    Margin="0"
                    Width="120"
                    Click="CloseButton_Click"
                    Content="Cerrar"/>
        </StackPanel>
    </Grid>
</Window>
