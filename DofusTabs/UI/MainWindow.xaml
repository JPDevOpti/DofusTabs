<Window x:Class="DofusTabs.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="DofusTabs"
        Height="560"
        Width="920"
        MinHeight="460"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/Icon.png"
        Background="#131515">
    <Window.Resources>
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Background" Value="#2A2F2F"/>
            <Setter Property="BorderBrush" Value="#3E4545"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#384040"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#222626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarBubbleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <TranslateTransform X="0" Y="4"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.16"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                             To="0"
                                             Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#202424" BorderBrush="#353B3B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="AccountsListBox"
                             Grid.Row="0"
                             Margin="2,4,2,2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Center"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="AccountsListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="AccountsListBox_PreviewMouseMove"
                             DragOver="AccountsListBox_DragOver"
                             DragLeave="AccountsListBox_DragLeave"
                             Drop="AccountsListBox_Drop"
                             SelectionMode="Single"
                             SelectionChanged="AccountsListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <StaticResource ResourceKey="SidebarListBoxItemStyle"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="SelectedAccountBackground"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="1">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource SidebarBubbleButtonStyle}"
                                                Click="AccountBubble_Click"
                                                PreviewMouseRightButtonDown="AccountBubble_PreviewMouseRightButtonDown"
                                                Tag="{Binding}"
                                                ToolTip="{Binding SidebarCharacterName}">
                                            <Button.ContextMenu>
                                                <ContextMenu Opened="AccountContextMenu_Opened">
                                                    <MenuItem Click="ToggleAccountEnabledFromSidebar_Click"/>
                                                    <MenuItem Click="SetPrimaryFromSidebar_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid Width="34" Height="34" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Ellipse Fill="#2D3333" Stroke="#D5C17A" StrokeThickness="2"/>
                                                <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IconPath}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding AvatarInitial}" FontSize="12" FontWeight="Bold" Foreground="#EEE6C9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IconPath}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="★"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#F3C94A"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Bottom"
                                                           Margin="-6,0,0,-1">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,1">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#7CD75F"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Fill" Value="#D75F5F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Grid>
                                        </Button>
                                        <TextBlock Text="{Binding SidebarCharacterName}"
                                                   Margin="0,2,0,0"
                                                   Width="46"
                                                   FontSize="9"
                                                   Foreground="#CFD6D6"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=Tag}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="SelectedAccountBackground" Property="Background" Value="#2B3131"/>
                                        <Setter TargetName="SelectedAccountBackground" Property="BorderBrush" Value="#4A5353"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="1" Margin="3,1,3,3" Padding="2" Background="#171919" BorderBrush="#353B3B" BorderThickness="1">
                        <Grid HorizontalAlignment="Center">
                            <TextBlock x:Name="AccountsSummaryText" Text="0 cuentas" Visibility="Collapsed"/>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SidebarIconButtonStyle}" Click="RefreshButton_Click" ToolTip="Refrescar cuentas">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="12" Foreground="#E5E8E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarIconButtonStyle}" Click="SettingsButton_Click" ToolTip="Ajustes">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="12" Foreground="#E5E8E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="4" Background="#0F1010" BorderBrush="#353B3B" BorderThickness="1">
                <Grid Background="#080909">
                    <wfi:WindowsFormsHost x:Name="GameHost" Focusable="False">
                        <wf:Panel x:Name="GameHostPanel" BackColor="Black"/>
                    </wfi:WindowsFormsHost>
                    <TextBlock x:Name="EmptyHostText"
                               Text="Abre clientes de Dofus y selecciona una cuenta en la sidebar"
                               Foreground="#6F7B7B"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="HostTitleText" Text="Cliente Activo"/>
                        <TextBlock x:Name="StatusTextBlock" Text="Esperando clientes..."/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

